# For Upstash Redis - Full URL
REDIS_URL=rediss://default:your_password@your-instance.upstash.io:6379

# For CloudAMQP - Full URL
RABBITMQ_URL=amqps://user:password@lemon.rmq.cloudamqp.com/vhost

# Or use individual configs (local development)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_VHOST=/

SOCKET_IO_PORT=5000
WORKER_PORT=5001

ENV=development
DEBUG=true

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# Player identity tokens (rejoin) live for 2 hours
PLAYER_JWT_EXPIRE_MINUTES=120
MC_USERNAME=mc
MC_PASSWORD_HASH=
